          "params": {
            "query.term": "uricase OR \"urate oxidase\""
          }
        },
        {
          "id": "mechanism-urat1",
          "params": {
            "query.term": "URAT1 OR SLC22A12"
          }
        },
        {
          "id": "mechanism-nlrp3",
          "params": {
            "query.term": "NLRP3"
          }
        },
        {
          "id": "mechanism-intestinal-urate",
          "params": {
            "query.term": "(intestinal OR gut OR microbiome OR probiotic) AND (urate OR uric acid)"
          }
        }
      ]
    },
