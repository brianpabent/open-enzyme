{
  "schema_version": 1,
  "clinical_trials": {
    "initial_since": "2026-04-23",
    "clinicaltrials_gov": {
      "base_url": "https://clinicaltrials.gov/api/v2",
      "page_size": 100,
      "profiles": [
        {
          "id": "condition-gout",
          "params": {
            "query.cond": "gout"
          }
